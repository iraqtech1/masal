ADMIN_USER=masal
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3001
HOST=127.0.0.1
# Persistent database path; mount this directory on durable storage in production.
DB_PATH=server/data/masal.sqlite
# Local verification only. Disable for real users.
DEV_OTP=false
# HTTPS webhook receives {phone,code}; keep provider credentials server-side.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Use NODE_ENV=production behind an HTTPS reverse proxy.
# Static preview builds only: VITE_DATA_MODE=preview

# Optional: 32-byte base64 inventory encryption key. Back up securely outside Git.
# If omitted, the server creates a private <DB_PATH>.key alongside the database.
# INVENTORY_KEY=
# Optional local module exporting documented topup/rabia adapters. No live adapter is bundled.
PROVIDER_ADAPTER_MODULE=
